# ── Complex model: DeepSeek V3 via NVIDIA NIM ──────────────────────────────
# Used for: JD analysis + project/experience selection + bullet rewriting
# Get your key at: https://build.nvidia.com/deepseek-ai/deepseek-v3
COMPLEX_MODEL=nvidia_nim/deepseek-ai/deepseek-v3-0324
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Simple model: Groq Llama (lightweight tasks + fallback) ────────────────
# Get your key at: https://console.groq.com
SIMPLE_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here

# ── Fallback: triggered when complex model fails ───────────────────────────
FALLBACK_MODEL=cerebras/llama3.1-8b
FALLBACK_API_KEY=your_cerebras_api_key_here

# ── AI generation globals ──────────────────────────────────────────────────
AI_TIMEOUT=120
MAX_TOKENS=4096
COMPLEX_TEMPERATURE=0.0
SIMPLE_TEMPERATURE=0.0

# ── Pre-ranking ────────────────────────────────────────────────────────────
# LLM sees top (required_slots * PROJECT_CANDIDATE_MULTIPLIER) projects
PROJECT_CANDIDATE_MULTIPLIER=2
# Token overlap ratio to consider a JD keyword "grounded"
ATS_MATCH_THRESHOLD=0.6

# ── File paths ─────────────────────────────────────────────────────────────
BASE_RESUME_PATH=../base/resume.tex
PROJECTS_BANK_PATH=../base/projects.tex
EXPERIENCE_BANK_PATH=../base/experience.tex

OUTPUTS_DIR=outputs
DATA_DIR=data

HOST=0.0.0.0
PORT=8000
DEBUG=false
